# Copy this file to local.toml and fill in your secrets.
# local.toml is gitignored by default.
#
# Load order (later wins): config/default.toml -> config/{NEKO_ENV}.toml ->
# .env -> {NEKO_SECRETS_FILE} -> NEKO__-prefixed env vars.
# Only the keys you set here override the defaults.

[websocket]
url = "ws://127.0.0.1:3001"
token = "your_napcat_token"

[sqlite]
# path = "data/neko.db"  # created automatically if missing

# Local embedding server (see scripts/local_embedding_server.py).
# The vector_dim here must match the output dimension of the chosen model.
[embedding]
base_url = "http://127.0.0.1:8000/v1"
model = "local"
api_key = "local"

# Leave qdrant.url empty to fall back to the in-memory vector store.
# The URL is the gRPC endpoint (port 6334), not the REST port 6333.
[qdrant]
url = "http://127.0.0.1:6334"
collection = "long_term_memory"
vector_dim = 512

# Leave neo4j.uri empty to fall back to the in-memory graph store.
[neo4j]
uri = "bolt://127.0.0.1:7687"
user = "neo4j"
password = "password"

# Provider selection per layer. detective/solidify are optional: when absent
# they fall back to the council provider.
[llm]
gate = "deepseek"
council = "grok"
# detective = "grok"
# solidify = "grok"

# Gate / Council providers. Use your own keys for real LLM calls.
[llm.providers.deepseek]
api_key = "sk-..."

[llm.providers.grok]
api_key = "xai-..."

[llm.providers.gemini]
api_key = "..."

# Late-night memory solidification schedule (cron). Empty timezone = UTC.
# [solidify]
# cron = "0 0 3 * * *"
# timezone = "Asia/Shanghai"

# Minimum seconds between two replies from the bot to the same group.
# Within this window, extra replies are suppressed (default 3).
# [personality]
# min_reply_interval_sec = 3
